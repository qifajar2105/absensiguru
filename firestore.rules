rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email in ['nurayeshaalfajar@gmail.com', 'shobirhana@gmail.com'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin')
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || isSuperAdmin();
      allow write: if isOwner(userId) || isAdmin() || isSuperAdmin();
    }
    
    match /attendance/{docId} {
      allow read: if isAdmin() || isSuperAdmin() || (isAuthenticated() && resource.data.teacherId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if isAdmin() || isSuperAdmin();
    }
    
    match /school_settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isSuperAdmin();
    }

    match /system_config/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /licenses/{docId} {
      allow read: if true; // Allows the login screen to check
      allow write: if isSuperAdmin();
    }

    match /superadmins/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /subjects/{docId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    match /students/{docId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    match /student_attendance/{docId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }
  }
}
